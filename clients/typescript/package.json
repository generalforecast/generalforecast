{
  "name": "@generalforecast/client",
  "version": "0.1.0",
  "description": "General Forecast API client: score rows with a predictor from Node 20+ or a browser",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"test/**/*.test.mjs\""
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
